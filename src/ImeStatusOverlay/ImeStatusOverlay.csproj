<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ImeStatusOverlay</AssemblyName>
    <RootNamespace>ImeStatusOverlay</RootNamespace>
    <Platforms>x64</Platforms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Application icon (embedded as Win32 resource for the EXE, and also
         available via pack URI for WPF window icons). -->
    <Content Include="app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Resource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Avoid Color/Size ambiguity with WPF; files that need it use explicit usings. -->
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
