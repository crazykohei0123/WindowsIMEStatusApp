<Application x:Class="ImeStatusOverlay.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <!-- App icon used by WPF windows (taskbar/alt-tab when shown). -->
            <BitmapImage x:Key="AppIconSource" UriSource="pack://application:,,,/app.ico"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
