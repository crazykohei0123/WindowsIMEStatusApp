<Window x:Class="ImeStatusOverlay.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IME状態表示 - 設定"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ResizeMode="NoResize"
        Background="#FF1E1E1E"
        Foreground="#FFF3F3F3"
        FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI">
    <StackPanel Margin="24">
        <TextBlock Text="表示テキストの変更"
                   FontSize="18" FontWeight="Bold" Margin="0,0,0,10" />

        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" Foreground="#FF9AA0A6"
                   Text="IME切り替え時に画面中央に表示されるテキストを変更できます。空欄にすると既定値に戻ります。" />

        <TextBlock Text="IME ON のとき" FontWeight="Bold" />
        <TextBox x:Name="OnTextBox" Margin="0,4,0,12" Padding="8,6" FontSize="14"
                 Background="#FF2B2B2B" Foreground="#FFF3F3F3" BorderBrush="#FF555555" />

        <TextBlock Text="IME OFF のとき" FontWeight="Bold" />
        <TextBox x:Name="OffTextBox" Margin="0,4,0,6" Padding="8,6" FontSize="14"
                 Background="#FF2B2B2B" Foreground="#FFF3F3F3" BorderBrush="#FF555555" />

        <TextBlock x:Name="Status" Text="" Foreground="#FF9AA0A6" Margin="0,6,0,0"
                   TextWrapping="Wrap" />

        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" Content="既定に戻す" Padding="12,8" Margin="0,0,8,0"
                    Click="Defaults_Click" />
            <Button Grid.Column="2" Content="キャンセル" Padding="12,8" Margin="0,0,8,0"
                    Click="Cancel_Click" />
            <Button Grid.Column="3" Content="保存" Padding="16,8"
                    IsDefault="True" Click="Save_Click" />
        </Grid>
    </StackPanel>
</Window>
